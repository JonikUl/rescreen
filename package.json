{
  "name": "rescreen",
  "version": "0.1.0",
  "description": "CLI для визуального регрессионного тестирования: Snapshot'ы страниц, сравнение с Baseline'ами, самодостаточный HTML Report",
  "keywords": [
    "cli",
    "pixelmatch",
    "playwright",
    "screenshot",
    "testing",
    "visual-regression",
    "visual-testing"
  ],
  "homepage": "https://github.com/JonikUl/rescreen#readme",
  "bugs": "https://github.com/JonikUl/rescreen/issues",
  "license": "MIT",
  "author": "Evgeniy Gromin <evgeniy.gromin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonikUl/rescreen.git"
  },
  "bin": {
    "rescreen": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test run",
    "build": "vp pack",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite-plus": "^1.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.5.1"
}
